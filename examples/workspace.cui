<Ui>
  <Resources>
    <Image Key="pattern" Source="pattern.png"/>
  </Resources>

  <Data>
    <Value Key="app" Text="CloverPic"/>
    <Value Key="doc" Text="untitled.cloverpic"/>
    <Value Key="accent" Color="#2F6FD0"/>
    <Value Key="zoom" Number="141"/>
    <Value Key="tool" Text="Brush"/>
    <Value Key="filter" Text=""/>
  </Data>

  <Styles>
    <Style TargetType="TextBlock" FontSize="12" Foreground="#CBD2D9"/>
    <Style TargetType="Button" Background="#2A2E33" Foreground="#E8ECF0"
           CornerRadius="5" Padding="12,6" BorderThickness="1" BorderBrush="#3B4048"/>
    <Style Class="accent" Background="#2F6FD0" Foreground="#FFFFFF" BorderBrush="#4C8DE8"/>
    <Style Class="dim" Foreground="#8B939D"/>
    <Style x:Name="root" Background="#1A1C20"/>
    <Style x:Name="header" CornerRadius="8"/>
    <Style x:Name="glow" CornerRadius="10"/>
    <Style x:Name="toolbar" Background="#23262A" Padding="10"/>
    <Style x:Name="status" Background="#191B1E" Padding="12,6"/>
    <Style x:Name="panel" Background="#1D2024" Padding="10" CornerRadius="8"/>
    <Style x:Name="row" Background="#262A2F" CornerRadius="4" Padding="8,0"/>
    <Template x:Key="chip">
      <Border Background="#2F6FD0" CornerRadius="12" Padding="16,7">
        <TextBlock Text="{Binding Content}" Foreground="#FFFFFF"/>
      </Border>
    </Template>
  </Styles>

  <StackPanel x:Name="root" Width="Fill" Height="Fill">
    <StackPanel x:Name="toolbar" Orientation="Horizontal" Spacing="8">
      <Button Content="Select" Class="accent"/>
      <Button Content="Brush"/>
      <Button Content="Eraser"/>
      <Button Content="Fill"/>
      <Button Content="Chip" Template="chip" Cursor="pointer"/>
      <Button Content="Menu ▲" Cursor="pointer"/>
      <TextBox x:Name="filter" Text="{Binding filter}" Placeholder="Filter layers..."
               Width="180" Height="30" Background="#1B1E22" Foreground="#E8ECF0"
               CornerRadius="5" BorderThickness="1" BorderBrush="#3B4048"/>
    </StackPanel>

    <Panel x:Name="header" Height="54" Margin="12,12,12,0" BackgroundGradient="Linear"
           GradientAngle="0" GradientStops="0:#1F4FA8, 1:#2F6FD0">
      <TextBlock Text="渐变 + 模板 (Gradient + Template)" FontSize="16" Foreground="#FFFFFF"
                 VerticalAlignment="Center" Margin="16,0"/>
    </Panel>

    <StackPanel Orientation="Horizontal" Spacing="12" Padding="12" Width="Fill" Height="Fill">
      <StackPanel x:Name="panel" Width="190" Spacing="6" Height="Fill">
        <TextBlock Text="图层 LAYERS" Class="dim"/>
        <ScrollViewer Height="Fill" Width="Fill">
          <Panel Height="30" x:Name="row"><TextBlock Text="图层 1 · 草稿" VerticalAlignment="Center"/></Panel>
          <Panel Height="30" x:Name="row"><TextBlock Text="素描 Sketch" VerticalAlignment="Center"/></Panel>
          <Panel Height="30" x:Name="row"><TextBlock Text="上色 Colour" VerticalAlignment="Center"/></Panel>
          <Panel Height="30" x:Name="row"><TextBlock Text="阴影 Shadow" VerticalAlignment="Center"/></Panel>
          <Panel Height="30" x:Name="row"><TextBlock Text="线稿 Line art" VerticalAlignment="Center"/></Panel>
          <Panel Height="30" x:Name="row"><TextBlock Text="高光 Highlights" VerticalAlignment="Center"/></Panel>
          <Panel Height="30" x:Name="row"><TextBlock Text="备注 Notes" VerticalAlignment="Center"/></Panel>
        </ScrollViewer>
      </StackPanel>

      <Panel x:Name="glow" Width="Fill" Height="Fill" Background="#15171A"
             BackgroundImage="{StaticResource pattern}" BackgroundImageFit="Cover"
             BackgroundImageOpacity="0.85">
        <TextBlock Text="{Binding doc}" FontSize="16" Foreground="#E8ECF0"/>
      </Panel>
    </StackPanel>

    <Panel x:Name="floating" Position="360,150" Width="248" Height="96"
           Background="#242A31" CornerRadius="10" BorderThickness="1" BorderBrush="#3B424B"
           Drag="panel-floating">
      <TextBlock Text="浮动面板 · 拖动我" FontSize="14" Foreground="#E8ECF0"
                 Margin="14,12,14,0"/>
      <TextBlock Text="Position 绝对定位 + Drag 手势" FontSize="11" Foreground="#8A929C"
                 Margin="14,38,14,0"/>
    </Panel>

    <StackPanel x:Name="status" Orientation="Horizontal" Spacing="18">
      <TextBlock Text="工具 {Binding tool}"/>
      <TextBlock Text="{Binding doc}"/>
      <TextBlock Text="{Binding zoom}"/>
    </StackPanel>
  </StackPanel>

  <!-- Overlay: paints above the page and is hit first, so nothing clips it. -->
  <Overlay>
    <Panel Position="300,300" Width="260" Height="120" Background="#2B3138" CornerRadius="10"
           BorderThickness="1" BorderBrush="#4A525C" Cursor="default">
      <TextBlock Text="弹出层 · Overlay" FontSize="14" Foreground="#FFFFFF" Margin="14,10,14,0"/>
      <TextBlock Text="不被父容器裁剪，命中优先" FontSize="11" Foreground="#98A1AC" Margin="14,36,14,0"/>
    </Panel>
  </Overlay>
</Ui>
